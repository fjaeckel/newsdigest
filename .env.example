# Copy to .env and fill in. Only one of the two Claude credentials is needed.

# --- Option A: your Claude subscription (recommended, no per-token billing) ---
# On a machine where you are logged into Claude Code, run:
#     claude setup-token
# and paste the token it prints here.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Option B: the Anthropic API, billed per token ---
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Force a backend instead of auto-detecting: cli | api
# NEWSDIGEST_BACKEND=

# --- Web UI ---
# Any random string. Required if the app is reachable from the internet:
# without it, anyone who finds the URL can read your digest.
#     openssl rand -hex 24
# Open https://your-host/?t=THIS_VALUE once on your phone; it sets a cookie
# and you stay logged in.
DIGEST_TOKEN=

# How many days of digests to keep. 0 disables pruning.
NEWSDIGEST_KEEP_DAYS=30
